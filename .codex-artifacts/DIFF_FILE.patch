+{% extends "base.html" %}
+{% block title %}Upcoming - AniWorld Downloader{% endblock %}
+{% block content %}
+<div class="page-header"><div><h1 data-i18n="upcoming.title">Upcoming movies</h1><p class="subtitle" data-i18n="upcoming.subtitle">Track unreleased movies and queue them after an exact match is found.</p></div><button class="btn btn-secondary" id="checkUpcomingBtn" data-i18n="upcoming.check">Check now</button></div>
