+  display: none;
+}
+
+.upcoming-config-notice strong {
+  display: block;
+  color: var(--text-strong);
+  margin-bottom: 3px;
+}
+
+.upcoming-search-row {
+  align-items: flex-end;
+}
+
+.upcoming-search-row .field {
+  min-width: 260px;
+}
+
+.upcoming-results {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  margin-top: 20px;
+}
+
+.upcoming-results[hidden] {
+  display: none;
+}
+
+.upcoming-result-card {
+  width: 154px;
+  cursor: default;
+}
+
+.upcoming-result-card img,
+.upcoming-poster-placeholder {
+  width: 100%;
+  height: 228px;
+}
+
+.upcoming-poster-placeholder {
+  display: grid;
+  place-items: center;
+  background: var(--surface-poster);
+  color: var(--text-muted);
+  font-size: 2rem;
+}
+
+.upcoming-add-btn {
+  width: 100%;
+  margin-top: 10px;
+}
+
+.upcoming-row-message {
+  max-width: 330px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.upcoming-actions {
+  text-align: right;
+  white-space: nowrap;
+}
+
+.upcoming-actions .btn + .btn {
+  margin-left: 6px;
+}
+
+@media (max-width: 640px) {
+  .upcoming-config-notice {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .upcoming-search-row > .btn {
